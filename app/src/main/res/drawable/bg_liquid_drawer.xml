<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/liquid_drawer_fill" />
            <corners
                android:bottomRightRadius="30dp"
                android:topRightRadius="30dp" />
            <stroke
                android:width="1.1dp"
                android:color="@color/liquid_glass_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@android:color/transparent"
                android:startColor="@color/liquid_glass_sheen_top"
                android:type="linear" />
            <corners
                android:bottomRightRadius="30dp"
                android:topRightRadius="30dp" />
        </shape>
    </item>
</layer-list>
